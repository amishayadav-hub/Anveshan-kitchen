rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Recipes and products are publicly readable — no auth needed
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // Community recipe submissions — anyone can submit (create), but no one
    // can read others' submissions or edit/delete. The Anveshan team reviews
    // and features the best ones via the Firebase console / admin SDK.
    match /submissions/{submissionId} {
      allow create: if
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() < 100 &&
        request.resource.data.recipeName is string &&
        request.resource.data.recipeName.size() > 0 &&
        request.resource.data.recipeName.size() < 150 &&
        request.resource.data.products is list &&
        request.resource.data.products.size() > 0 &&
        request.resource.data.products.size() < 25 &&
        request.resource.data.status == "pending" &&
        request.resource.data.featured == false;
      allow read, update, delete: if false;
    }
  }
}
